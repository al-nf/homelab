#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo 'Usage: yocto-fhs <workspace-directory> <kas-command> [arguments...]' >&2
    echo 'Example: yocto-fhs . shell kas/zynq.yml' >&2
    exit 2
fi
cd "$1"
shift
export KAS_WORK_DIR="$PWD"
export KAS_BUILD_DIR="${KAS_BUILD_DIR:-$PWD/build}"
export DL_DIR="${DL_DIR:-$PWD/downloads}"
export SSTATE_DIR="${SSTATE_DIR:-$PWD/sstate-cache}"
exec kas "$@"
