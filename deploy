#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$repo_dir"
pi_target="${1:-${RMM_DEPLOY_TARGET:-afung@100.98.188.45}}"
if [[ $# -gt 1 || ! "$pi_target" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.@:-]*$ ]]; then
  printf 'Usage: ./deploy [user@pi-or-ssh-alias]\n' >&2
  exit 1
fi
if [[ "${HOMELAB_DEV_SHELL:-}" != 1 ]] || ! command -v rsync >/dev/null || ! command -v ssh >/dev/null || ! command -v go >/dev/null; then
  exec nix --extra-experimental-features 'nix-command flakes' develop "path:$repo_dir" --command bash "$repo_dir/deploy" "$@"
fi
printf 'Building ./rmm-server for the Pi…\n'
(cd services/rmm-server && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -buildvcs=false -o "$repo_dir/rmm-server" .)
# Reuse the repo's pinned nixpkgs version for tmux on the Pi.
nixpkgs_rev="$(awk -F '"' '/"rev"/ { print $4; exit }' flake.lock)"
if [[ ! "$nixpkgs_rev" =~ ^[a-f0-9]{40}$ ]]; then
  printf 'Cannot read the nixpkgs revision from flake.lock.\n' >&2
  exit 1
fi
tmux_ref="github:NixOS/nixpkgs/$nixpkgs_rev#tmux"
printf 'Uploading to %s:~/rmm-server/rmm-server…\n' "$pi_target"
ssh "$pi_target" 'mkdir -p "$HOME/rmm-server"'
rsync -az -- ./rmm-server "$pi_target:rmm-server/rmm-server"
ssh "$pi_target" "nix --extra-experimental-features 'nix-command flakes' shell '$tmux_ref' --command bash -s" <<'REMOTE'
set -euo pipefail
cd "$HOME/rmm-server"
tmux kill-session -t =homelab 2>/dev/null || true
# Also replace an earlier dashboard launched outside this tmux session.
listeners="$(ss -H -ltnp 'sport = :8080')"
if [[ -n "$listeners" ]]; then
  listener_pid="$(printf '%s\n' "$listeners" | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -n 1)"
  listener_exe=""
  listener_owner=""
  if [[ -n "$listener_pid" ]]; then
    listener_exe="$(readlink "/proc/$listener_pid/exe" 2>/dev/null || true)"
    listener_exe="${listener_exe% (deleted)}"
    listener_owner="$(stat -c '%u' "/proc/$listener_pid" 2>/dev/null || true)"
  fi
  if [[ "$listener_owner" != "$(id -u)" ]]; then
    printf 'Port 8080 is occupied; cannot replace a process owned by another user:\n%s\n' "$listeners" >&2
    exit 1
  fi
  case "$listener_exe" in
    */rmm-server|*/wolserver|*/homelab-dashboard)
      printf 'Stopping previous dashboard (PID %s)…\n' "$listener_pid"
      kill -TERM "$listener_pid"
      ;;
    *)
      printf 'Port 8080 belongs to %s (PID %s); leaving it running.\n' "$listener_exe" "$listener_pid" >&2
      exit 1
      ;;
  esac
fi
# Allow the previous listener to close before starting its replacement.
for attempt in {1..50}; do
  if [[ -z "$(ss -H -ltn 'sport = :8080')" ]]; then break; fi
  sleep 0.1
done
if [[ -n "$(ss -H -ltn 'sport = :8080')" ]]; then
  printf 'Port 8080 is still occupied. Check whether another supervisor is restarting the old process.\n' >&2
  exit 1
fi
tmux new-session -d -s homelab -n rmm-server -c "$PWD" './rmm-server; read -r'
if ! ./rmm-server -health-check; then
  printf '\nDashboard startup output:\n' >&2
  tmux capture-pane -p -S -80 -t homelab:rmm-server >&2 || true
  exit 1
fi
printf '\nDashboard updated. View logs with: tmux attach -t homelab\n'
REMOTE
